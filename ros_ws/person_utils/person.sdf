<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="person_model">
    <static>false</static>
    <link name="person_link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>file:///root/ros_workspace/person_utils/meshes/standing.dae</uri>
            <scale>0.5 0.5 0.3</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.3</radius>   
              <length>1.0</length>     
            </cylinder>
          </geometry>
          <pose>0 0 0.5 0 0 0</pose>
      </collision>
    </link>
  </model>
</sdf>
